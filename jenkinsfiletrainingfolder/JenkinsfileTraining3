pipeline {
    agent any
    options {
        timeout(time: 10, units: 'MINUTES')
    }
    stages {
        stage('Build') {
            steps {
                mkdir logs
                cat logs/
            }
        }
        stage('Test') {
             steps {
                 echo 'test'
             }
        }
        stage('Archive') {
              steps {
                  archiveArtifacts artifacts: 'logs/**', fingerprint: true
              }
        }
    }
    post {
        always {
            junit 'reports/*.xml'
        }
        failure {
            echo 'failure'
        }
        success {
            echo 'success'
        }
    }
}